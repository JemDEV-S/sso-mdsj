# --- Conexión al SSO ---
# Emisor (issuer) del SSO. Debe coincidir EXACTAMENTE con SSO_ISSUER del SSO.
SSO_ISSUER=http://127.0.0.1:8085

# --- Credenciales del cliente registrado en /admin/clients ---
# El client_id que te asignó el SSO al registrar el cliente del Bridge.
SSO_CLIENT_ID=
# El client_secret mostrado UNA SOLA VEZ al registrar el cliente. No lo compartas.
SSO_CLIENT_SECRET=

# --- Parámetros del Bridge ---
# Puerto local del Bridge. El redirect_uri registrado en el SSO debe usar este puerto.
PORT=8095
# URL de callback registrada en el SSO (coincidencia exacta).
BRIDGE_REDIRECT_URI=http://127.0.0.1:8095/bridge/callback
# Scopes solicitados. 'openid' es obligatorio; 'dni' aporta el DNI; 'profile' el nombre.
SSO_SCOPES=openid profile dni

# Secreto para firmar la cookie de sesión del Bridge (server-side).
# Genera uno aleatorio, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Traspaso seguro al SGD (Etapa 2 · Paso 2) ---
# Si estas dos variables están vacías, /bridge/callback solo muestra los claims
# (modo Etapa 1). Si están presentes, firma un JWT corto y redirige al SGD.
#
# Secreto compartido HS256 entre el Bridge y el SGD. Debe ser EXACTAMENTE igual
# a SGD_SSO_SHARED_SECRET en el servidor del SGD. Genera uno aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SGD_SHARED_SECRET=
# URL del callback real del SGD (donde se canjea el JWT por una sesión).
SGD_CALLBACK_URL=http://192.168.90.12:8080/sgd/sso-callback
# TTL de la credencial de traspaso, en segundos (por defecto 60).
SGD_TOKEN_TTL_SECONDS=60
